      "id": "decision:cli-for-humans-and-agents",
      "type": "Decision",
      "label": "kg is a CLI for humans and AI agents",
      "description": "What: kg turns a project's code, dependencies, docs, tests and decisions into a knowledge graph that can be queried, rendered and exported, from a CLI usable by people and by agents.\nWhy: The client wants agents to reason over a project's structure instead of rediscovering it.\nWhere: docs/requirements.md, docs/discovery.md",
      "attrs": {
        "created": "2026-10-07",
        "session": "session:2026-10-07-9f063e5d",
        "status": "active"
      },
      "provenance": {
