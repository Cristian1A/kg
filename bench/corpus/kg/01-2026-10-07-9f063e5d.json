    {
      "id": "constraint:kg-calls-no-llm",
      "type": "Constraint",
      "label": "kg itself calls no model (RF-24)",
      "description": "What: kg never calls an LLM. Agents write their knowledge (documents, decisions, concepts) through `kg add`; kg validates and stores it.\nWhy: Deterministic, offline, free to run; the agent that uses kg already is a model.\nWhere: docs/requirements.md RF-24",
      "attrs": {
