      }
    },
    {
      "id": "decision:staleness-by-digest",
      "type": "Decision",
      "label": "kg status detects changes by content digest",
      "description": "What: RF-77: `kg status` compares file content digests with those recorded at extraction, rather than git commits, and lists modified, added and deleted files.\nWhere: docs/store.md; docs/requirements.md RF-77",
